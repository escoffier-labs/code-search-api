# Code Search API Configuration

# API key for protected endpoints. Leave unset to disable auth.
CODE_SEARCH_API_KEY=

# Root directory to scan for code repositories.
CODE_SEARCH_WORKSPACE=./repos

# Optional second root for reference docs or supporting material.
CODE_SEARCH_REFERENCE=

# SQLite database path.
CODE_SEARCH_DB=./code_index.db

# CORS origins. Use * for all, or comma-separated list.
CODE_SEARCH_CORS_ORIGINS=*

# Ollama connection.
OLLAMA_URL=http://localhost:11434

# Embedding model. See README for options and VRAM requirements.
# Recommended: qwen3-embedding:8b (~6GB VRAM, best quality)
# Lightweight:  nomic-embed-text (~300MB VRAM, fast)
CODE_SEARCH_EMBED_MODEL=qwen3-embedding:8b

# Safety override for changing embedding models on an existing DB.
# Leave unset unless you intentionally want to re-stamp and re-index.
# CODE_SEARCH_ALLOW_MODEL_CHANGE=1

# Summary lane. agy (Gemini via the Antigravity CLI) and codex (Codex CLI) run as
# subprocesses on their own login; ollama means a LOCAL Ollama model only; none
# disables summaries. See README "Summary Models".
CODE_SEARCH_SUMMARY_PROVIDER=agy
CODE_SEARCH_SUMMARY_MODEL=gemini-3.8-flash-low
# CODE_SEARCH_SUMMARY_FALLBACK=
CODE_SEARCH_SUMMARY_BATCH_SIZE=8
# Chunks sent to a subscription lane per local day (0 = off, negative = unlimited).
CODE_SEARCH_SUMMARY_DAILY_CAP=500

# Runtime tuning.
CODE_SEARCH_SUMMARY_WORKERS=4
CODE_SEARCH_DB_BATCH_SIZE=100
CODE_SEARCH_CACHE_TTL_SECONDS=3600
